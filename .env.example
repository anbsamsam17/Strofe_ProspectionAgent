# ============================================================
# AGENT IA — PROSPECTION BILAN CARBONE
# Copie ce fichier en .env.local et remplis toutes les valeurs
# Ne committe JAMAIS .env.local dans git
# ============================================================

# ------------------------------------------------------------
# SUPABASE
# Récupérer sur : supabase.com → Project Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# OPENAI (ChatGPT API)
# Récupérer sur : platform.openai.com → API Keys
# Modèle utilisé : gpt-4o
# ------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...

# ------------------------------------------------------------
# INSEE SIRENE API
# Récupérer sur : portail-api.insee.fr → Applications → ton app → OAuth2
# Le token Bearer est généré automatiquement par le code (expire tous les 7j)
# ------------------------------------------------------------
INSEE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
INSEE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# RESEND (emails transactionnels)
# Récupérer sur : resend.com → API Keys
# ------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=agent@strofe.fr

# ------------------------------------------------------------
# SENTRY (monitoring erreurs)
# Récupérer sur : sentry.io → Settings → Projects → DSN
# ------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://...@o123456.ingest.sentry.io/789
SENTRY_ORG=ton-organisation
SENTRY_PROJECT=agent-prospection
SENTRY_AUTH_TOKEN=sntrys_...

# ------------------------------------------------------------
# CRON SECRET
# Générer avec : openssl rand -hex 32
# Protège l'endpoint /api/agent/run des appels non autorisés
# ------------------------------------------------------------
CRON_SECRET=ton_secret_genere_avec_openssl

# ------------------------------------------------------------
# APP URL
# En dev : http://localhost:3000
# En prod : https://decarbonleads.strofe.fr
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# OPTIONNEL — Enrichissement contacts (choisir un seul)
# Apollo.io : apollo.io → Settings → API Keys
# Dropcontact : dropcontact.com → API
# ------------------------------------------------------------
# APOLLO_API_KEY=
# DROPCONTACT_API_KEY=
