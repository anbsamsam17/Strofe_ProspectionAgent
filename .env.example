# Variables d'environnement pour l'Agent de Prospection - Bilan Carbone
# Copiez ce fichier en .env et renseignez vos valeurs.

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Nombre maximum de prospects à traiter en une session
MAX_PROSPECTS=10

# Langue des messages générés (fr | en | ...)
LANGUAGE=fr
